FROM python:3.12-slim
WORKDIR /app
COPY envs/wildfire_response/core /app/core
COPY envs/wildfire_response/openenv /app/openenv
RUN pip install --no-cache-dir /app/core /app/openenv
COPY eval/incident_day_server.py /app/eval/incident_day_server.py
EXPOSE 8005
CMD ["python", "-m", "eval.incident_day_server", "--fixture", "--host", "127.0.0.1", "--port", "8005"]
